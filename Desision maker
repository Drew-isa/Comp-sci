def log_in(usr_name, usr_password):
    global attempts, id_user
   
    if attempts >= 3: # if they have more then 3 attempts it destorys the sign in/up and stops the log in
        MainScreen.destroy()
        while True: #locks the user
            messagebox.showwarning("Problem with log in", "Locked out")

    row = run_db_command("SELECT Users.password, Users.User_ID FROM Users WHERE Users.username = ?", (usr_name, ), "log_in") 
    if row == None: # if there is no row then the username was not found in the database
        messagebox.showwarning("Problem with log in", "Inputed username was not found")
        return

    db_password = row[0] # the query will return a tuple going [password, username]
    id_user = row[1] # gets the id of the user

    if db_password == usr_password:
        go_to_x("Decision Tree", Credentials, DecisionsScreen) # moves onto the next part
        
        lbl_username_main.config(text=f"[{usr_name}]")
        create_list_of_relevent_decisions(id_user)
    else:
        attempts += 1
        lbl_tries.config(text=f"tries: {attempts}")
       

def sign_up(usr_name, usr_password):
    global id_user
    
    if len(usr_password) < 7:
        messagebox.showwarning("Problem with sign up", "Password needs to be atleast 7 characters long")
        return

    row = run_db_command("SELECT Users.password, Users.User_ID FROM Users WHERE Users.username = ?", (usr_name, ), "sign_up") 


    if row != None or usr_name == "":
        messagebox.showwarning("Problem with sign in", "Username has already been selected or empty")
        return

    id_user = insert_into("INSERT INTO Users (username, password) VALUES (?, ?)", (usr_name, usr_password), "sign_up") # im not sure if id_user acctauly is global
    
    go_to_x("Decision Tree", Credentials, DecisionsScreen) # moves to the next page
    print("Account made")
    lbl_username_main.config(text=f"[{usr_name}]")
    create_list_of_relevent_decisions(id_user)


