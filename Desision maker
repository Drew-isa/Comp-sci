def run_db_command(sql_statment, inserts, location):
    try:
        with con:
            cur = con.execute(sql_statment, inserts)
            row = cur.fetchone()
            return row
    except Exception as e:
        print(f" Error {e} at {location}")


def insert_into(sql_statment, inserts, location):
    try:
        with con: # REMEMBER TO ADD WITH CON
            cur = con.execute(sql_statment, inserts) # the question marks stop injections
            sel_id = cur.lastrowid # gets the id of new user WHICH IS ESSENTIAL
            return sel_id
    except Exception as e:
        print(f"{e} at {location}")

