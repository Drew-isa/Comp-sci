        recent_comparison = compair_greater(name_of_mover, current_factor[0])

        if recent_comparison == "y": # we know that everything in the temp can be less than mover
            train[movers_pos_in_train][2] = current_factor[1] # movers the movers tail to factors head#
        elif recent_comparison == "n": # if the user says that factor is less than mover THIS STILL NEEDS TO BE CHECKED
            temp.append([current_factor[0], current_factor[1], current_factor[2]])

