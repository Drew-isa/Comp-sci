def add_factor(): # this will always have undeffined factors, and has been independently checked and so should work
    factors_name = input("what is the name of the factor? ")
   
    pro = ""
    while pro not in {"y", "n"}:
        pro = input("Is this a pro or a con? (y - pro, n - con): ")
       
    if pro == "y":
        pro = 1
    else:
        pro = 0
   
    if len(train) == 0: # the only time we can't compair a new factor to something in the trian is when there is nothing in the train
        train.append([factors_name, 0, -1, pro])
        return # looks nicer
   
    temp_comp = train[randint(0, len(train)-1)]
    user_comparison = compair_greater(factors_name, temp_comp[0])
   
    if user_comparison == "y": # if the user says that new_factor < temp_comp or temp_comp > new_factor
        Bottom_of_new_factor = temp_comp[1] # the tail of the new factor is the head of the compairson
        Top_of_new_factor = Bottom_of_new_factor + 1
       
    else: # if the user says that a>b
        Top_of_new_factor = temp_comp[2] # the head of the new factor is the tail of the compairison
        Bottom_of_new_factor = Top_of_new_factor - 1
       
    train.append([factors_name, Top_of_new_factor, Bottom_of_new_factor, pro]) # inserts b into the train

