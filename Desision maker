    temp = []
   
    for o in range(len(train)):
        if train[o][1] <= anchors_head and train[o][1] > movers_tail: # This adds every factor to the temp if they could be incorrectly placed in relation to mover including the anchor THIS HAS BEEN SEPERATLY TESTED
            temp.append(train[o])
               
    for i in range(len(temp)): # Sorts the temp list lowest to higest head with selection sort, can run up to 1000 items very quickly
        pos_of_min = i
        for j in range(i+1, len(temp)):
            if(temp[j][1] < temp[pos_of_min][1]):
                pos_of_min = j
        if(pos_of_min != i):
            temp[i], temp[pos_of_min] = temp[pos_of_min], temp[i]
     
    update_positions_past = len(temp)
    k = 0

    while len(temp) > 0: # takes temp bit by bit starting at the lowest part and compair
        current_factor = temp.pop(0) # .pops WILL EVENTALY GET RID OF THIS AND JUST DIRECLY PLACE    REEEMMMMEMBER THAT THIS POPS SO EVERY POSITIONAL THING SHOULD NOT BE A i BUT AT 0
       
