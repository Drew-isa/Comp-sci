rooms = []


def list_rooms():
        for room in rooms:
            print(room.get_name())
            
def find_room(num):
    for room in rooms:
        if num == room.get_name():
            guest = input("Name of guest? ")
            room.book(guest)
            print(f"Okay room {num} booked")
        
class Room:
    def __init__(self, room_num, guest_name, price):
        self._room_num = room_num
        
        if guest_name == "None":
            guest_name = None
        
        self._guest_name = guest_name
        self._price = price
        
        
        #print(self._room_num, self._guest_name, self._price)
            
    def get_status(self):
        print(self._room_num, self._guest_name, self._price)
            
    def book(self, guest):       
        self._guest_name = guest
            
    def get_name(self):
        return self._room_num
try:
